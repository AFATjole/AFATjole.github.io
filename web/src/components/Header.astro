---
import {localeNames, localePath, locales, navigation, switchLocalePath, t, type Locale} from '@/lib/i18n'

interface Props {
  lang: Locale
  siteName: string
}
const {lang, siteName} = Astro.props
const path = Astro.url.pathname
const isActive = (p: string) => path.startsWith(localePath(lang, p))
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href={localePath(lang)} class="text-lg font-normal tracking-wide">{siteName}</a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Main">
      {
        navigation.map((item) => (
          <a
            href={localePath(lang, item.path)}
            class:list={['text-sm transition-colors hover:text-ink', isActive(item.path) ? 'font-normal text-ink' : 'text-muted']}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            {t(lang, item.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <div class="flex gap-2 text-sm">
        {
          locales.map((l) => (
            <a
              href={switchLocalePath(path, l)}
              hreflang={l}
              class:list={[l === lang ? 'font-normal text-ink' : 'text-muted hover:text-ink']}
              aria-current={l === lang ? 'true' : undefined}
            >
              {localeNames[l]}
            </a>
          ))
        }
      </div>

      <details class="group relative lg:hidden">
        <summary class="cursor-pointer list-none text-sm" aria-label={t(lang, 'menu')}>
          <span class="block h-0.5 w-6 bg-ink" />
          <span class="mt-1.5 block h-0.5 w-6 bg-ink" />
          <span class="mt-1.5 block h-0.5 w-6 bg-ink" />
        </summary>
        <nav class="absolute right-0 mt-4 flex w-56 flex-col border border-line bg-paper p-2 shadow-lg" aria-label="Mobile">
          {
            navigation.map((item) => (
              <a href={localePath(lang, item.path)} class="px-3 py-2 text-sm hover:bg-neutral-100">
                {t(lang, item.key)}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
