---
import SanityImage from '@/components/SanityImage.astro'
import {pick, type Locale} from '@/lib/i18n'
import type {Page} from '@/lib/sanity/types'

interface Props {
  lang: Locale
  page: Page
}
const {lang, page} = Astro.props
---

<section class="mx-auto max-w-7xl px-4 pt-20 pb-20 sm:px-6">
  <h1 class="t-display">{pick(page.title, lang)}</h1>
  {page.intro && <p class="t-sub mt-8 max-w-[560px]">{pick(page.intro, lang)}</p>}
</section>
{
  page.heroImage?.asset && (
    <div class="mx-auto mb-20 max-w-7xl px-4 sm:px-6">
      <SanityImage image={page.heroImage} lang={lang} width={1600} aspect={21 / 9} loading="eager" />
    </div>
  )
}
