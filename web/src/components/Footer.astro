---
import {localePath, navigation, pick, t, type Locale} from '@/lib/i18n'
import type {Settings} from '@/lib/sanity/types'

interface Props {
  lang: Locale
  settings: Settings
}
const {lang, settings} = Astro.props
const siteName = pick(settings.siteName, lang) ?? ''
const {email, phone} = settings.contact ?? {}
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-semibold">{siteName}</p>
      {settings.tagline && <p class="mt-2 text-sm text-muted">{pick(settings.tagline, lang)}</p>}
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Footer">
      {navigation.map((item) => <a href={localePath(lang, item.path)} class="text-muted hover:text-ink">{t(lang, item.key)}</a>)}
    </nav>
    <div class="space-y-1 text-sm text-muted md:text-right">
      {email && <a href={`mailto:${email}`} class="block hover:text-ink">{email}</a>}
      {phone && <a href={`tel:${phone.replace(/\s/g, '')}`} class="block hover:text-ink">{phone}</a>}
      {
        settings.social?.map((s) => s.url && (
          <a href={s.url} class="block hover:text-ink" rel="noopener" target="_blank">{s.label}</a>
        ))
      }
    </div>
  </div>
  <p class="pb-8 text-center text-xs text-muted">© {new Date().getFullYear()} {siteName}</p>
</footer>
