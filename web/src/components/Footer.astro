---
import {localePath, navigation, pick, t, type Locale} from '@/lib/i18n'
import type {Settings} from '@/lib/sanity/types'

interface Props {
  lang: Locale
  settings: Settings
}
const {lang, settings} = Astro.props
const siteName = pick(settings.siteName, lang) ?? ''
const {email, phone} = settings.contact ?? {}
---

<footer class="mt-20 border-t border-line">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-3">
    <div>
      <p class="t-title">{siteName}</p>
      {settings.tagline && <p class="t-sub mt-2">{pick(settings.tagline, lang)}</p>}
    </div>
    <nav class="t-label flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      {navigation.map((item) => <a href={localePath(lang, item.path)} class="hover:text-muted">{t(lang, item.key)}</a>)}
    </nav>
    <div class="t-sub space-y-1 md:text-right">
      {email && <a href={`mailto:${email}`} class="block hover:text-ink">{email}</a>}
      {phone && <a href={`tel:${phone.replace(/\s/g, '')}`} class="block hover:text-ink">{phone}</a>}
      {
        settings.social?.map((s) => s.url && (
          <a href={s.url} class="block hover:text-ink" rel="noopener" target="_blank">{s.label}</a>
        ))
      }
    </div>
  </div>
  <p class="t-label pb-10 text-center text-muted">© {new Date().getFullYear()} {siteName}</p>
</footer>
