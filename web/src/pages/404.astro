---
import BaseLayout from '@/layouts/BaseLayout.astro'
import {defaultLocale, isLocale, localePath, t} from '@/lib/i18n'

// Static 404: guess the language from the URL on the client is not possible at
// build time, so render the default language.
const lang = isLocale(Astro.params.lang) ? Astro.params.lang : defaultLocale
---

<BaseLayout lang={lang} title={t(lang, 'notFound')}>
  <section class="mx-auto max-w-7xl px-4 py-32 text-center sm:px-6">
    <p class="text-6xl font-normal">404</p>
    <p class="mt-4 text-muted">{t(lang, 'notFound')}</p>
    <a href={localePath(lang)} class="mt-8 inline-block border-b border-ink">{t(lang, 'backHome')}</a>
  </section>
</BaseLayout>
