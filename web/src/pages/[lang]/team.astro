---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import PortableText from '@/components/PortableText.astro'
import SanityImage from '@/components/SanityImage.astro'
import {localeParams, pick, type Locale} from '@/lib/i18n'
import {getPage, getTeam} from '@/lib/sanity/content'

export const getStaticPaths = localeParams

const lang = Astro.params.lang as Locale
const [page, team] = await Promise.all([getPage('page-team'), getTeam()])
---

<BaseLayout lang={lang} title={pick(page.title, lang)} seo={page.seo}>
  <PageHeader lang={lang} page={page} />
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <PortableText value={pick(page.body, lang)} class="mb-16 max-w-3xl" />
    <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map((member) => (
          <li>
            <SanityImage image={member.photo} lang={lang} width={600} aspect={3 / 4} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
            <h2 class="mt-4 font-normal">{pick(member.name, lang)}</h2>
            <p class="text-sm text-muted">{pick(member.role, lang)}</p>
            {member.bio && <p class="mt-3 text-sm">{pick(member.bio, lang)}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
