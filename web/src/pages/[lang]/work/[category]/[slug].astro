---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PortableText from '@/components/PortableText.astro'
import SanityImage from '@/components/SanityImage.astro'
import {localePath, locales, pick, t, type Locale} from '@/lib/i18n'
import {getWork, getWorks} from '@/lib/sanity/content'

export async function getStaticPaths() {
  const works = await getWorks()
  return locales.flatMap((lang) =>
    works
      .filter((w) => w.category?.slug)
      .map((w) => ({params: {lang, category: w.category!.slug, slug: w.slug}})),
  )
}

const lang = Astro.params.lang as Locale
const work = await getWork(Astro.params.slug!)
if (!work) throw new Error(`Work not found: ${Astro.params.slug}`)
const title = pick(work.title, lang)
---

<BaseLayout lang={lang} title={title} description={pick(work.summary, lang)} seo={work.seo}>
  <article class="mx-auto max-w-7xl px-4 pt-20 sm:px-6">
    <a href={localePath(lang, `work/${work.category?.slug}`)} class="t-label text-muted hover:text-ink">
      ← {pick(work.category?.title, lang) ?? t(lang, 'work.back')}
    </a>
    <header class="mt-10 grid gap-10 lg:grid-cols-3">
      <h1 class="t-display lg:col-span-2">{title}</h1>
      <dl class="grid grid-cols-2 gap-6 self-end">
        {work.client && (<div><dt class="t-label text-muted">{t(lang, 'work.client')}</dt><dd class="t-title mt-1">{work.client}</dd></div>)}
        {work.year && (<div><dt class="t-label text-muted">{t(lang, 'work.year')}</dt><dd class="t-title mt-1">{work.year}</dd></div>)}
      </dl>
    </header>
    {work.summary && <p class="t-sub mt-8 max-w-[560px]">{pick(work.summary, lang)}</p>}

    <div class="mt-20">
      <SanityImage image={work.coverImage} lang={lang} width={1600} loading="eager" />
    </div>

    <PortableText value={pick(work.body, lang)} class="mt-20" />

    <div class="mt-20 space-y-6">
      {
        work.gallery?.map((item) =>
          item._type === 'video' ? (
            item.url && <video class="w-full" src={item.url} controls muted playsinline preload="metadata" />
          ) : (
            <SanityImage image={item} lang={lang} width={1600} />
          ),
        )
      }
    </div>
  </article>
</BaseLayout>
