---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PortableText from '@/components/PortableText.astro'
import SanityImage from '@/components/SanityImage.astro'
import WorkGrid from '@/components/WorkGrid.astro'
import {localeParams, localePath, pick, t, type Locale} from '@/lib/i18n'
import {getHome} from '@/lib/sanity/content'

export const getStaticPaths = localeParams

const lang = Astro.params.lang as Locale
const home = await getHome()
const {hero} = home
---

<BaseLayout lang={lang} seo={home.seo}>
  <section class="relative">
    {
      hero?.video?.url ? (
        <video class="h-[70vh] w-full object-cover" src={hero.video.url} autoplay muted loop playsinline />
      ) : hero?.image?.asset ? (
        <SanityImage image={hero.image} lang={lang} width={2400} aspect={16 / 9} loading="eager" class="h-[70vh]" />
      ) : null
    }
    <div class="mx-auto max-w-7xl px-4 pt-20 pb-20 sm:px-6">
      <h1 class="t-display max-w-5xl">
        {pick(hero?.heading, lang)}
        {hero?.subheading && (<><br /><span class="gray">{pick(hero.subheading, lang)}</span></>)}
      </h1>
    </div>
  </section>

  <div class="mx-auto mb-20 max-w-7xl px-4 sm:px-6">
    <PortableText value={pick(home.intro, lang)} />
  </div>

  {
    home.featured && home.featured.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="mb-10 flex items-end justify-between gap-6">
          <h2 class="t-h2">{t(lang, 'nav.work')}</h2>
          <a href={localePath(lang, 'work')} class="t-label shrink-0 hover:text-muted">{t(lang, 'work.viewAll')} →</a>
        </div>
        <WorkGrid lang={lang} works={home.featured} />
      </section>
    )
  }
</BaseLayout>
